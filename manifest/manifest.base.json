{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "default_locale": "en",
    "description": "%#description#%",
    "icons": {
        "16": "icons/icon-16.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "storage",
        "downloads",
        "clipboardWrite",
        "alarms",
        "contextMenus",
        "notifications",
        "declarativeNetRequest"
    ],
    "optional_permissions": [],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "%#background_key#%": "%#background_value#%"
    },
    "action": {
        "default_popup": "popup/index.html",
        "default_title": "%#action_title#%"
    },
    "options_ui": {
        "page": "options/index.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/guard-main.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/guard.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.iwara.tv/*"
            ],
            "js": [
                "content/main-world.js"
            ],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.iwara.tv/*"
            ],
            "js": [
                "content/isolated.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        },
        {
            "matches": [
                "*://*.iwara.tv/*"
            ],
            "js": [
                "content/page-ui.js"
            ],
            "css": [
                "content/page-ui.css"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ]
}