{
    "name": "iwara-assistant",
    "version": "0.1.13",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "build": "node --import tsx/esm ./build/index.ts chrome && node --import tsx/esm ./build/index.ts firefox && node --import tsx/esm ./build/package.ts",
        "build:chrome": "node --import tsx/esm ./build/index.ts chrome",
        "build:firefox": "node --import tsx/esm ./build/index.ts firefox",
        "build:icons": "node --import tsx/esm ./build/icons.ts",
        "dev:chrome": "node --import tsx/esm ./build/index.ts chrome --watch",
        "dev:firefox": "node --import tsx/esm ./build/index.ts firefox --watch",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "package": "node --import tsx/esm ./build/package.ts",
        "package:chrome": "node --import tsx/esm ./build/package.ts chrome",
        "package:firefox": "node --import tsx/esm ./build/package.ts firefox",
        "test:e2e": "playwright test",
        "test:e2e:headless": "node --import tsx/esm ./build/env.ts E2E_HEADLESS=1 -- playwright test",
        "test:e2e:wdio": "wdio run ./wdio.conf.ts",
        "test:e2e:wdio:chrome": "node --import tsx/esm ./build/env.ts WDIO_BROWSER=chrome -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:firefox": "node --import tsx/esm ./build/env.ts WDIO_BROWSER=firefox -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:headless": "node --import tsx/esm ./build/env.ts E2E_HEADLESS=1 -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:live": "node --import tsx/esm ./build/env.ts E2E_LIVE=1 -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:live:chrome": "node --import tsx/esm ./build/env.ts E2E_LIVE=1 WDIO_BROWSER=chrome -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:live:firefox": "node --import tsx/esm ./build/env.ts E2E_LIVE=1 WDIO_BROWSER=firefox -- wdio run ./wdio.conf.ts",
        "test:e2e:wdio:live:human": "node --import tsx/esm ./build/env.ts E2E_LIVE=1 E2E_HUMAN=1 -- wdio run ./wdio.conf.ts",
        "test:e2e:manual": "npm run build:chrome && node --import tsx/esm ./build/env.ts E2E_MANUAL=1 WDIO_BROWSER=chrome -- wdio run ./wdio.conf.ts",
        "test:e2e:manual:firefox": "npm run build:firefox && node --import tsx/esm ./build/env.ts E2E_MANUAL=1 WDIO_BROWSER=firefox -- wdio run ./wdio.conf.ts",
        "test:unit": "node --import tsx/esm --test \"test/*.test.ts\"",
        "test:firefox:smoke": "node --import tsx/esm ./e2e/firefox-smoke.mts",
        "type-check": "tsc --noEmit",
        "type-check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
        "type-check:wdio": "tsc -p e2e/wdio/tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "dayjs": "^1.11.13",
        "i18next": "^26.5.2",
        "idb": "^8.0.3",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-i18next": "^17.1.0",
        "sonner": "^2.0.8",
        "zod": "^4.0.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@types/chrome": "^0.1.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.15.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@wdio/cli": "^10.0.2",
        "@wdio/local-runner": "^10.0.2",
        "@wdio/mocha-framework": "^10.0.1",
        "@wdio/spec-reporter": "^10.0.1",
        "@wdio/types": "^10.0.1",
        "chromedriver": "^155.0.0",
        "esbuild": "^0.25.0",
        "geckodriver": "^7.0.0",
        "prettier": "^3.9.10",
        "tsx": "^4.19.2",
        "typescript": "^5.9.2",
        "web-ext": "^8.10.0",
        "webdriverio": "^10.0.2"
    },
    "allowScripts": {
        "chromedriver@155.0.0": true,
        "edgedriver@7.0.0": true,
        "geckodriver@7.0.0": true
    }
}