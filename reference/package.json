{
  "name": "iwara-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx/esm ./build/index.ts",
    "build:chrome": "node --import tsx/esm ./build/index.ts chrome",
    "build:firefox": "node --import tsx/esm ./build/index.ts firefox",
    "dev:chrome": "node --import tsx/esm ./build/index.ts chrome --watch",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx/esm --experimental-strip-types ./test/main.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.20",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.12.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "web-ext": "^8.7.0"
  }
}
